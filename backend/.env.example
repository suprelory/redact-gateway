# 主密钥（用于加密映射表，至少 32 字符）
MASTER_KEY=your-secret-master-key-min-32-characters

# 端口配置
PROXY_PORT=18787
MANAGEMENT_PORT=18788

# 管理令牌（访问管理界面需要，至少 16 字符）
ADMIN_TOKEN=your-admin-token-min-16-chars

# 数据目录
DATA_DIR=./data

# 日志级别
LOG_LEVEL=info

# CORS 配置
CORS_ORIGIN=*

# 请求体大小限制（字节）
MAX_BODY_BYTES=33554432

# 最大脱敏条目数
MAX_REDACTIONS=16384

# 映射过期时间（秒，默认 7 天）
MAPPING_TTL=604800

# 允许的上游主机（逗号分隔，为空则允许所有）
# ALLOWED_HOSTS=api.openai.com,api.anthropic.com
