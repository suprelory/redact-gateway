REDACT_GATEWAY_IMAGE=ghcr.io/your-org/redact-gateway:latest
REDACT_ADMIN_TOKEN=replace-with-a-long-random-token

REDACT_BIND_HOST=127.0.0.1
REDACT_PROXY_PORT=8787
REDACT_ADMIN_PORT=8788

# Leave empty to allow arbitrary public HTTP/HTTPS upstreams.
REDACT_ALLOWED_HOSTS=api.openai.com,api.anthropic.com
REDACT_ALLOW_PRIVATE_UPSTREAMS=0
REDACT_MAX_BODY_BYTES=16777216
REDACT_MAX_REDACTIONS=16384
REDACT_LOG_RETENTION_DAYS=30
TZ=Asia/Shanghai
